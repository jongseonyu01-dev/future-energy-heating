[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  if (saved?.success !== true) {[m
[32m+[m[32m    return { ok: false, reason: "SAVE_FAILED" };[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  let confirmed: LocationConsentReadResponse;[m
[32m+[m[32m  try {[m
[32m+[m[32m    confirmed = await getConsent();[m
[32m+[m[32m  } catch {[m
[32m+[m[32m    return { ok: false, reason: "READBACK_FAILED" };[m
[32m+[m[32m  }[m
